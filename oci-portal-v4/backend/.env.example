# ──────────────────────────────────────────────────────────────────────────
# OCI Portal Configuration
# Copy this file to .env and update values for your environment
# ──────────────────────────────────────────────────────────────────────────

# Application Environment
APP_ENV=development
# APP_ENV=production

# Secret key for JWT tokens (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# Access token expiration in hours
ACCESS_TOKEN_EXPIRE_HOURS=8

# Database URL
# Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./oci_portal.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oci_portal

# OCI Configuration
# Set to 0 for API key auth (reads ~/.oci/config)
# Set to 1 for Instance Principal auth (production in OCI)
OCI_INSTANCE_PRINCIPAL=0

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=debug.log
AUDIT_LOG_FILE=audit.log

# ──────────────────────────────────────────────────────────────────────────
# JDE Cache Management Configuration
# ──────────────────────────────────────────────────────────────────────────

# Base URL for JDE Cache Management API
CACHE_API_BASE=http://JDESMC/manage/mgmtrestservice

# Cache API credentials
CACHE_API_USER=jde_admin
CACHE_API_PASSWORD=jde_admin
